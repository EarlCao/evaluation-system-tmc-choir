# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. NEVER commit real secrets.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5280

# HMAC key for opaque, non-reversible feedback IDs (see docs: Privacy Model)
FEEDBACK_ID_KEY=change-me

# Public URL of the SPA (used in password-reset links).
# Dev ports: Django `runserver 8010`, Vite 5280 (see frontend/vite.config.ts;
# override with VITE_BACKEND_URL / FRONTEND_PORT when starting Vite).
FRONTEND_URL=http://localhost:5280

# ---------------------------------------------------------------------------
# Database (MySQL 8 locally via docker compose, or Aiven for MySQL in production)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=choir_eval
MYSQL_USER=choir
MYSQL_PASSWORD=change-me
# Host port mapped to the MySQL container (3307 avoids clashes with other local MySQL servers)
MYSQL_HOST_PORT=3307
DATABASE_URL=mysql://choir:change-me@127.0.0.1:3307/choir_eval
# For Aiven for MySQL on Render:
# DATABASE_URL=mysql://avnadmin:<password>@<service>-<project>.aivencloud.com:<port>/defaultdb?ssl-mode=REQUIRED
# DB_SSL_REQUIRED=True
# DB_SSL_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ---------------------------------------------------------------------------
# Redis (shared channel layer, registration/OTP state, settings cache and throttles)
# Production requires Redis. memory:// is for development only.
# ---------------------------------------------------------------------------
REDIS_HOST_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0

# Docker dev stack (docker compose up -d --build). Inside the containers DATABASE_URL and
# REDIS_URL are overridden to the service names; these only choose the host ports.
BACKEND_HOST_PORT=8010
FRONTEND_HOST_PORT=5280

# ---------------------------------------------------------------------------
# Email & Real OTP Delivery (Create Account & Forgot Password)
# When EMAIL_HOST_USER and EMAIL_HOST_PASSWORD are set, Django automatically switches
# to the real SMTP backend (`django.core.mail.backends.smtp.EmailBackend`).
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.org
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=15
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password

# ---------------------------------------------------------------------------
# Cloud Deployment: Vercel (Frontend) + Render (Backend)
# ---------------------------------------------------------------------------
# Backend (Render):
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# SESSION_COOKIE_SAMESITE=None
# CSRF_COOKIE_SAMESITE=None
#
# Frontend (Vercel environment variables):
# VITE_API_BASE_URL=https://your-backend.onrender.com/api/v1
# VITE_WS_BASE_URL=wss://your-backend.onrender.com

# Production (Docker Compose or Render; replace example hosts before use):
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=eval.your-choir.org
# FRONTEND_URL=https://eval.your-choir.org
# CSRF_TRUSTED_ORIGINS=https://eval.your-choir.org
# CORS_ALLOWED_ORIGINS=          # empty for a same-origin deployment
# USE_X_FORWARDED_FOR=True      # backend reachable only through your trusted proxy
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_AGE=43200
# SESSION_COOKIE_SAMESITE=Lax
# CSRF_COOKIE_SAMESITE=Lax
# TLS_CERTS_DIR=/absolute/path/to/certs
# DB_SSL_CA=/absolute/path/to/mysql-ca.pem
# DB_CONN_MAX_AGE=0
# BACKUP_DIR=/app/backups       # directory inside the backend container
# BACKUP_COMPOSE_FILE=deploy/docker-compose.prod.yml
# BACKUP_RETENTION_DAYS=30
# BACKUP_PASSPHRASE=            # set outside this file for encrypted off-host SQL backups
# LOG_LEVEL=INFO
# EMAIL_FILE_PATH=              # used only by the isolated browser-test stack
