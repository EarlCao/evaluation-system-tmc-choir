# ---- Secrets & local config (never commit) ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Django ----
backend/staticfiles/
backend/media/
*.sqlite3

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo
npm-debug.log*
.vite/

# ---- Playwright ----
test-results/
playwright-report/
playwright/.cache/

# ---- Backups & dumps (protected, never in git) ----
backups/
*.sql
*.sql.gz
*.dump

# ---- Obsidian (keep shared config, ignore per-user state) ----
docs/.obsidian/workspace*.json
docs/.obsidian/cache
docs/.trash/

# ---- Editors / OS ----
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db
desktop.ini
.agents/

# Local verification logs (never deployment input).
.readiness/
